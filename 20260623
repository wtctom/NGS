import math
import numpy as np
from sklearn.linear_model import LinearRegression
from collections import defaultdict

in_file = "/home/xiaol/wtc/260622/CG024/all_cdr_aa_x_count2.txt"
out_file = "/home/xiaol/wtc/260622/CG024/cdr_slope_result2.tsv"

# 1. 按横坐标m分组，统计每个样本总reads
sample_total = defaultdict(int)
sample_data = defaultdict(list)
with open(in_file, "r") as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        cdr_key, raw_cnt, m = line.split()
        raw_cnt = int(raw_cnt)
        m = float(m)
        sample_data[m].append((cdr_key, raw_cnt))
        sample_total[m] += raw_cnt

# 2. 计算每条CDR的 y = log2(p)，p=序列reads/样本总reads
cdr_xy = defaultdict(list)
for m, item_list in sample_data.items():
    total_s = sample_total[m]
    clone_num = len(item_list)
    for cdr, cnt in item_list:
        # 伪计数避免log2(0)报错
        p = (cnt + 1) / (total_s + clone_num)
        y = math.log2(p)
        cdr_xy[cdr].append((m, y))

# 3. 逐序列一元线性回归
with open(out_file, "w") as out:
    # 表头：CDR三联、出现样本数、截距β0、富集斜率β1、拟合优度R²
    out.write("cdr1|cdr2|cdr3\tsample_count\tbeta0_intercept\tbeta1_slope\tR2\n")
    for cdr_key, xy_list in cdr_xy.items():
        # 少于2个样本无法做回归，直接跳过
        if len(xy_list) < 2:
            continue
        xs = np.array([x[0] for x in xy_list]).reshape(-1, 1)
        ys = np.array([x[1] for x in xy_list])
        reg = LinearRegression()
        reg.fit(xs, ys)
        beta0 = reg.intercept_
        beta1 = reg.coef_[0]
        r2 = reg.score(xs, ys)
        out.write(f"{cdr_key}\t{len(xy_list)}\t{beta0:.4f}\t{beta1:.4f}\t{r2:.4f}\n")
print("回归计算完成，输出：", out_file)
print("beta1_slope越大，富集越强（负筛低、阳性样本高）")
EOF

