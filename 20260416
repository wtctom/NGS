#自动识别列位置（cloneId, readCount, aaSeqCDR1, aaSeqFR2, aaSeqCDR2, aaSeqFR3, aaSeqCDR3）。
#拼接这五个字段（直接连接）作为完整氨基酸序列 aaSeqFull。
#按 aaSeqFull 分组，保留第一次出现的 cloneId，累加 readCount。
#输出三列：cloneId（原ID）、readCount（累加后）、aaSeqFull。
awk 'BEGIN {FS=OFS="\t"}
     NR==1 {
         for(i=1;i<=NF;i++) {
             if($i=="cloneId") cid=i;
             if($i=="readCount") rc=i;
             if($i=="aaSeqCDR1") cdr1=i;
             if($i=="aaSeqFR2") fr2=i;
             if($i=="aaSeqCDR2") cdr2=i;
             if($i=="aaSeqFR3") fr3=i;
             if($i=="aaSeqCDR3") cdr3=i;
         }
         print "cloneId", "readCount", "aaSeqFull";
         next;
     }
     {
         key = $cdr1 $fr2 $cdr2 $fr3 $cdr3;
         if (!(key in first_clone)) {
             first_clone[key] = $cid;
             sum_rc[key] = $rc;
             order[++n] = key;
         } else {
             sum_rc[key] += $rc;
         }
     }
     END {
         for(i=1;i<=n;i++) {
             key = order[i];
             print first_clone[key], sum_rc[key], key;
         }
     }' output_full.clones_IGH.tsv > N28_merged_unique.tsv
#转为FASTA格式
awk 'BEGIN {FS=OFS="\t"} NR>1 {print ">" $1 "|readCount=" $2; print $3}' N28_merged_unique.tsv > N28_merged_unique.fasta
