df.to_csv(csv_path, index=False)
np.save(npy_path, emb_50d)
plt.savefig(img_path, dpi=300)
plt.close()

# ------------------------------------------------------------------------------
# 生成中心序列
# ------------------------------------------------------------------------------
def get_centroids(embeddings, cluster_labels, headers, sequences):
    cluster_info = defaultdict(list)
    for e, l, h, s in zip(embeddings, cluster_labels, headers, sequences):
        if l == -1: continue
        cluster_info[l].append( (e,h,s) )
    cents = []
    for l, items in cluster_info.items():
        embs = [x[0] for x in items]
        mean_vec = np.mean(embs, axis=0)
        dists = [np.linalg.norm(e - mean_vec) for e in embs]
        best = items[np.argmin(dists)]
        cents.append( (l, best[1], best[2]) )
    return cents

centroids = get_centroids(embeddings, cluster_labels, headers, sequences)

cent_file = os.path.join(save_dir, "cluster_centroids.fasta")
with open(cent_file, "w") as f:
    for l, h, s in centroids:
        f.write(f">Cluster_{l}_centroid|{h}\n{s}\n")

print("🎉 全部完成！")
print(f"📁 聚类表：{csv_path}")
print(f"📁 50D向量：{npy_path}")
print(f"📁 t-SNE图：{img_path}")
print(f"📁 中心序列：{cent_file}")

