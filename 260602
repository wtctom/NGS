import torch
import numpy as np
import pandas as pd
from tqdm import tqdm
from esm.models.esmc import ESMC
from esm.tokenization.sequence_tokenizer import EsmSequenceTokenizer
from sklearn.decomposition import PCA
from sklearn.preprocessing import StandardScaler
import hdbscan
import os
import matplotlib.pyplot as plt
from sklearn.manifold import TSNE
from collections import defaultdict
# ------------------------------------------------------------------------------
# 1. 固定 ESMC-600M 模型配置（永久不变）
# ------------------------------------------------------------------------------
print("🔄 加载 ESMC-600M 模型...")
tokenizer = EsmSequenceTokenizer()
model = ESMC(
    tokenizer=tokenizer,
    d_model=1152,    # 固定
    n_heads=18,      # 固定
    n_layers=36      # 固定
)

# 你本地的模型权重路径（已经验证成功）
ckpt_path = "/home/xiaol/.cache/huggingface_esmc/models--EvolutionaryScale--esmc-600m-2024-12/blobs/8ef856e1a237ee3f995442df997a962e70057faadecf38fc0c8561bd3c2f4324"

state_dict = torch.load(ckpt_path, map_location="cuda", weights_only=True)
model.load_state_dict(state_dict)
model.eval()
model.to("cuda")
print("✅ 模型加载完成！")

# ------------------------------------------------------------------------------
# 2. 读取 FASTA 文件（你的目标文件）
# ------------------------------------------------------------------------------
FASTA_FILE = "/home/xiaol/wtc/old-result/results/S7_R1_OP_merged_unique.fasta"

def read_fasta(fasta_path):
    headers = []
    seqs = []
    with open(fasta_path, "r") as f:
        header = ""
        seq = ""
        for line in f:
            line = line.strip()
            if line.startswith(">"):
                if header:
                    headers.append(header)
                    seqs.append(seq)
                header = line[1:]
                seq = ""
            else:
                seq += line
        if header:
            headers.append(header)
            seqs.append(seq)
    return headers, seqs

headers, sequences = read_fasta(FASTA_FILE)
print(f"📄 读取到 {len(sequences)} 条序列")

# ------------------------------------------------------------------------------
# 3. 分批提取 embedding（防止显存爆掉）
# ------------------------------------------------------------------------------
BATCH_SIZE = 16  # 根据你的显存调整，显存小就改 4
embeddings = []

with torch.no_grad():
    for i in tqdm(range(0, len(sequences), BATCH_SIZE), desc="提取Embedding"):
        batch_seqs = sequences[i:i+BATCH_SIZE]
        inputs = tokenizer(
            batch_seqs,
            return_tensors="pt",
            padding=True,
            truncation=True
        ).to("cuda")
        
        outputs = model(inputs["input_ids"])
        # 平均池化得到整条序列的 embedding
        batch_emb = outputs.embeddings.mean(dim=1).cpu().numpy()
        embeddings.append(batch_emb)

# 拼接所有 embedding
embeddings = np.concatenate(embeddings, axis=0)
print(f"✅ Embedding 生成完成：{embeddings.shape}")

# ------------------------------------------------------------------------------
# 4. PCA 降维到 50 维
# ------------------------------------------------------------------------------
print("🔄 PCA 降维到 50 维...")
scaler = StandardScaler()
emb_scaled = scaler.fit_transform(embeddings)

pca = PCA(n_components=50, random_state=42)
emb_50d = pca.fit_transform(emb_scaled)
print(f"✅ 降维完成：{emb_50d.shape}")

# ------------------------------------------------------------------------------
# 5. HDBSCAN 聚类（无监督，不用设簇数）
# ------------------------------------------------------------------------------
print("🔄 HDBSCAN 聚类中...")
clusterer = hdbscan.HDBSCAN(
    min_cluster_size=5,    # 最小簇大小（可根据需求调整）
    min_samples=1,
    metric="euclidean"
)
cluster_labels = clusterer.fit_predict(emb_50d)

n_clusters = len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)
n_noise = list(cluster_labels).count(-1)

print(f"✅ 聚类完成：找到 {n_clusters} 个聚类，{n_noise} 个噪声点")

# ------------------------------------------------------------------------------
# 6. t-SNE 二维可视化
# ------------------------------------------------------------------------------
print("🔄 t-SNE 降维到 2D...")
tsne = TSNE(n_components=2, random_state=42, perplexity=30, max_iter=1000)
emb_2d = tsne.fit_transform(emb_50d)


# ------------------------------------------------------------------------------
# 7.画图
# ------------------------------------------------------------------------------
plt.figure(figsize=(10, 8))
plt.scatter(emb_2d[:,0], emb_2d[:,1], c=cluster_labels, cmap="tab20", s=50, alpha=0.8)
plt.colorbar(label="Cluster")
plt.title("ESMC-600M + t-SNE + HDBSCAN")
plt.tight_layout()
# ------------------------------------------------------------------------------
# 8. 保存结果 → 固定保存到 /home/xiaol/wtc/test
# ------------------------------------------------------------------------------
save_dir = "/home/xiaol/wtc/test"
os.makedirs(save_dir, exist_ok=True)

csv_path = os.path.join(save_dir, "ESMC600M_clustering_result.csv")
npy_path = os.path.join(save_dir, "ESMC600M_embedding_50d.npy")
img_path = os.path.join(save_dir, "tsne_cluster.png")

df = pd.DataFrame({
